[Unit]
Description=Photo Display Frame with Openbox
After=multi-user.target

[Service]
Type=simple
User=bread
Environment=DISPLAY=:0
WorkingDirectory=/home/bread/pi-frame
ExecStart=/home/bread/pi-frame/start-frame.sh -- :0 vt1
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/bread/pi-frame/photo-display.log
StandardError=append:/home/bread/pi-frame/photo-display.log

[Install]
WantedBy=multi-user.target
